FROM node:22-bullseye

ENV DEBIAN_FRONTEND=noninteractive

# ===============================
# SYSTEM & TOOLCHAIN
# ===============================
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    gcc \
    g++ \
    make \
    openjdk-17-jdk \
    coreutils \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ===============================
# PYTHON ML LIBRARIES
# ===============================
RUN pip3 install --no-cache-dir \
    numpy \
    pandas \
    scikit-learn

# (Optional – kalau masih mau plot)
# RUN pip3 install matplotlib seaborn

# ===============================
# NON-ROOT SANDBOX USER
# ===============================
RUN useradd -m sandbox

# ===============================
# NODE ENV
# ===============================
WORKDIR /backend

COPY package*.json ./
RUN npm install

RUN npm install -g nodemon

COPY . .

# ===============================
# RUNTIME DIRS
# ===============================
RUN mkdir -p /temp /backend/temp && \
    chmod -R 777 /temp /backend/temp

EXPOSE 5000

CMD ["nodemon", "-L", "index.js"]