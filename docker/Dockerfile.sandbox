FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ===== LANGUAGE TOOLCHAIN =====
RUN apt-get update && apt-get install -y \
  gcc \
  g++ \
  openjdk-17-jdk \
  coreutils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /sandbox

# ===== NON-ROOT EXECUTION =====
RUN useradd -m sandbox
RUN chown -R sandbox:sandbox /sandbox

USER sandbox

CMD ["bash"]
